{
  "name": "nord-market",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "docker:setup": "node scripts/docker-setup.mjs",
    "docker:up": "node scripts/docker-up.mjs",
    "docker:windows-setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows-docker-setup.ps1",
    "docker:down": "docker compose --env-file .env.docker -f compose.yaml -f compose.local.yaml down",
    "docker:logs": "docker compose --env-file .env.docker -f compose.yaml -f compose.local.yaml logs -f --tail=100",
    "test:smoke": "docker compose --env-file .env.docker exec -T backend php bin/smoke.php",
    "test:security": "docker compose --env-file .env.docker exec -T backend php bin/security-tests.php",
    "test:chat": "docker compose --env-file .env.docker -f compose.yaml -f compose.local.yaml exec -T backend php bin/chat-tests.php",
    "test:chat:scope": "node scripts/test-chat-scope.mjs",
    "test:backup": "node --test scripts/backup-crypto.test.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:decrypt": "node scripts/db-decrypt.mjs",
    "db:seed:lamps": "node scripts/db-seed-test-lamps.mjs",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "prettier": "^3.9.6",
    "prettier-plugin-sql": "^0.20.0",
    "sass": "^1.90.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.2",
    "vue-tsc": "^3.0.5"
  }
}
