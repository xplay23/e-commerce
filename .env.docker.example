# Copy to .env.docker; or run npm run docker:setup to generate strong passwords.
COMPOSE_PROJECT_NAME=nord
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
DB_NAME=nord_store
DB_USER=nord
DB_PASSWORD=
DB_ROOT_PASSWORD=
FRONTEND_URL=http://localhost:8080
DEV_FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:8080
# Generated by npm run docker:setup. Keep these keys outside backup archives.
APP_KEY=
BACKUP_ENCRYPTION_KEY=
# Local compose uses Mailpit. For VPS configure a real SMTP provider with TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@nord.test
# Used only with compose.vps.yaml. DNS must point to your VPS.
SITE_DOMAIN=shop.example.com
ACME_EMAIL=admin@example.com
# Server-side only. Never use a VITE_ prefix for API keys.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
